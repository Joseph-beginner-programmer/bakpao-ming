<h3 class="text-2xl font-semibold font-serif text-gray-700 mb-6 border-b-2 border-gray-300 pb-2">
    <%= title %>
</h3>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
    <% items.forEach(item=> { %>
        <div class="bg-white rounded-xl shadow-lg overflow-hidden flex flex-col pb-6">
            <img src="<%= item.image %>" alt="<%= item.name %>" class="w-full h-48 object-cover">

            <div class="p-6 flex flex-col flex-grow">
                <h4 class="text-xl font-bold font-serif text-gray-800">
                    <%= item.name %>
                </h4>

                <!-- description stretches to fill equal height -->
                <p class="text-gray-600 mt-2 flex-grow">
                    <%= item.description %>
                </p>

                <span class="block mt-2 font-semibold text-gray-600">Rp <%= item.price %></span>
            </div>

            <div class="flex justify-center gap-5 mt-2 ">
                <button
                    class="add-to-cart bg-yellow-500 hover:bg-yellow-700 text-center transition-all duration-300 text-md w-[120px] rounded-xl px-1 py-1 text-white font-bold"
                    data-id="<%= item._id %>">
                    Add to Cart
                </button>

            </div>
        </div>

        <% }) %>
</div>