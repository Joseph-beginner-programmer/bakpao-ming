<section id="cart" class="py-16 mt-20 bg-gray-50">
  <div class="container mx-auto px-6">
    <h2 class="text-4xl font-bold font-serif mb-12 text-gray-800 text-center">
      Your Cart
    </h2>

    <% if (cart.length === 0) { %>
      <p class="text-center text-gray-600 mb-6">Your cart is empty.</p>

      <div class="text-center">
        <a href="/menu"
          class="bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition font-bold">
          ← Back to Menu
        </a>
      </div>

    <% } else { %>
      <table class="w-full text-left border-collapse bg-white rounded-xl shadow-md overflow-hidden">
        <thead class="bg-gray-200">
          <tr>
            <th class="py-3 px-4">Item</th>
            <th class="py-3 px-4">Price</th>
            <th class="py-3 px-4 text-center">Quantity</th>
            <th class="py-3 px-4 text-right">Subtotal</th>
          </tr>
        </thead>
        <tbody id="cart-body">
          <% cart.forEach(item => { %>
            <tr class="border-b" data-id="<%= item.id %>">
              <td class="py-3 px-4 font-medium"><%= item.name %></td>
              <td class="py-3 px-4">Rp <%= item.price.toLocaleString('id-ID') %></td>
              <td class="py-3 px-4 text-center">
                <div class="flex items-center justify-center gap-3">
                  <button class="decrease bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold px-2 rounded">−</button>
                  <span class="quantity font-semibold"><%= item.quantity || 1 %></span>
                  <button class="increase bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold px-2 rounded">+</button>
                </div>
              </td>
              <td class="py-3 px-4 text-right subtotal">
                Rp <%= (item.price * (item.quantity || 1)).toLocaleString('id-ID') %>
              </td>
            </tr>
          <% }) %>
        </tbody>

        <!-- ✅ TOTAL ROW -->
        <tfoot>
          <tr class="bg-gray-100 font-bold text-gray-800">
            <td colspan="3" class="py-3 px-4 text-right">Total:</td>
            <td class="py-3 px-4 text-right" id="cart-total">
              Rp <%= cart.reduce((sum, i) => sum + i.price * (i.quantity || 1), 0).toLocaleString('id-ID') %>
            </td>
          </tr>
        </tfoot>
      </table>

      <div class="mt-8 flex justify-center gap-4">
        <a href="/menu"
          class="bg-gray-500 text-white px-6 py-3 rounded-lg hover:bg-gray-600 transition font-bold">
          ← Back to Menu
        </a>

        <a href="/checkout"
          class="bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition font-bold">
          Checkout via WhatsApp
        </a>
      </div>
    <% } %>
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const cartBody = document.getElementById("cart-body");
  const totalCell = document.getElementById("cart-total");

  function updateTotal() {
    let total = 0;
    document.querySelectorAll(".subtotal").forEach(cell => {
      const value = parseInt(cell.textContent.replace(/\D/g, "")) || 0;
      total += value;
    });
    totalCell.textContent = "Rp " + total.toLocaleString("id-ID");
  }

  cartBody.addEventListener("click", async (e) => {
    const row = e.target.closest("tr");
    if (!row) return;

    const id = row.dataset.id;
    const quantitySpan = row.querySelector(".quantity");
    let quantity = parseInt(quantitySpan.textContent);

    // Increase or decrease
    if (e.target.classList.contains("increase")) quantity++;
    if (e.target.classList.contains("decrease")) quantity--;

    if (quantity <= 0) {
      // Remove item visually and from server
      row.remove();
      await fetch(`/cart/remove`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id })
      });
      updateTotal();
      return;
    }

    // Update quantity display
    quantitySpan.textContent = quantity;

    // Update subtotal
    const price = parseInt(row.querySelector("td:nth-child(2)").textContent.replace(/\D/g, ""));
    const subtotalCell = row.querySelector(".subtotal");
    subtotalCell.textContent = "Rp " + (price * quantity).toLocaleString("id-ID");

    // Update total
    updateTotal();

    // Update on server
    await fetch(`/cart/update`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id, quantity })
    });
  });
});
</script>
