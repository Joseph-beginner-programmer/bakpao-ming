<!-- Navbar -->
<nav id="navbar" class="absolute top-0 left-0 w-full z-50 bg-transparent">
  <div class="w-full px-6">
    <div class="flex justify-center items-center py-1">
      <ul class="flex items-center space-x-8 text-white font-medium">

        <!-- Left links -->
        <li><a href="#order" class="hover:text-yellow-400 font-bold text-xl font-serif">Menu</a></li>

        <!-- Center Logo -->
        <li>
          <a href="/">
            <img src="img/logo-putih.png" alt="Logo" class="h-24 w-auto mx-4">
          </a>
        </li>

        <!-- Right links -->
        <li><a href="#location" class="hover:text-yellow-400 font-bold text-xl font-serif">Location</a></li>
      </ul>
    </div>
  </div>
</nav>

<!-- GSAP -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

<script>
  const navbar = document.getElementById("navbar");
  let isScrolled = false;

  window.addEventListener("scroll", () => {
    if (window.scrollY > 50 && !isScrolled) {
      isScrolled = true;

      navbar.classList.remove("absolute");
      navbar.classList.add("fixed");

      gsap.to(navbar, {
        backgroundColor: "rgba(0,0,0,80)", // slightly transparent for softer look
        duration: 1,                        // slower animation
        ease: "power4.inOut"                // smoother easing
      });

    } else if (window.scrollY <= 50 && isScrolled) {
      isScrolled = false;

      navbar.classList.remove("fixed");
      navbar.classList.add("absolute");

      gsap.to(navbar, {
        backgroundColor: "transparent",
        duration: 1,
        ease: "power4.inOut"
      });
    }
  });

</script>